{
  "name": "time-tracker",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun build --compile src/cli/index.ts --outfile dist/tt --minify",
    "dev": "bun run src/cli/index.ts",
    "db:push": "bunx drizzle-kit push",
    "typecheck": "bunx tsc --noEmit",
    "test": "vitest run --coverage && bun test tests/integration/",
    "test:unit": "vitest run",
    "test:integration": "bun test tests/integration/"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/luxon": "^3.7.1",
    "@vitest/coverage-v8": "^4.0.18",
    "drizzle-kit": "^0.31.9",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.3.0",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "drizzle-orm": "^0.45.1",
    "gunshi": "^0.29.2",
    "luxon": "^3.7.2",
    "zod": "^4.3.6"
  }
}
